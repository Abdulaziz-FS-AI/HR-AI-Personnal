# HR AI SaaS - Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control

# =============================================================================
# NEXTAUTH CONFIGURATION (REQUIRED)
# =============================================================================
# Generate a random 32+ character string for production
# You can generate one at: https://generate-secret.now.sh/32
NEXTAUTH_SECRET=your-super-secure-32-character-secret-here
NEXTAUTH_URL=http://localhost:3000

# =============================================================================
# AZURE SQL DATABASE (REQUIRED)
# =============================================================================
# Your Azure SQL Database connection details
# NO FALLBACK VALUES - These must be provided
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=your-database-name
AZURE_SQL_USER=your-database-username
AZURE_SQL_PASSWORD=your-secure-database-password

# =============================================================================
# AZURE STORAGE (REQUIRED)
# =============================================================================
# Azure Blob Storage for file uploads
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-account;AccountKey=your-key;EndpointSuffix=core.windows.net
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account-name
AZURE_STORAGE_ACCOUNT_KEY=your-storage-account-key

# =============================================================================
# AI SERVICE - HYPERBOLIC.XYZ (REQUIRED)
# =============================================================================
# Your Hyperbolic.xyz API key for AI analysis  
# Using Llama-3.3-70B-Instruct model for enhanced accuracy
HYPERBOLIC_API_KEY=your-hyperbolic-api-key-here
HYPERBOLIC_API_URL=https://api.hyperbolic.xyz/v1/chat/completions

# =============================================================================
# GOOGLE OAUTH (OPTIONAL)
# =============================================================================
# Google Cloud Console > APIs & Services > Credentials
# Create OAuth 2.0 Client ID for your domain
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# MICROSOFT OAUTH (OPTIONAL)
# =============================================================================
# Azure Portal > App Registrations > New Registration
# Set tenant to 'common' for multi-tenant support
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common

# =============================================================================
# AZURE SERVICE BUS (OPTIONAL)
# =============================================================================
# Only needed if using Azure Service Bus for queue management
AZURE_SERVICE_BUS_CONNECTION_STRING=your-service-bus-connection-string

# =============================================================================
# LEGACY AI SERVICES (DEPRECATED)
# =============================================================================
# These are no longer used but kept for backward compatibility
LLAMA_API_KEY=deprecated-not-used
LLAMA_API_URL=deprecated-not-used

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. Never commit .env.local to version control
# 2. Use strong, unique passwords for all services
# 3. Rotate API keys regularly
# 4. Use Azure Key Vault for production secrets
# 5. Monitor API usage and set up billing alerts
# 6. Enable audit logging for database access
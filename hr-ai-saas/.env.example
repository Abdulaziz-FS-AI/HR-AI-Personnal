# ===================================================================
# HR AI SaaS - Environment Configuration Template
# ===================================================================
# 
# SECURITY NOTICE:
# - NEVER commit .env.local or .env.production to version control
# - Replace all placeholder values with your actual credentials
# - Use Azure Key Vault for production secrets
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env.local for development
# 2. Replace placeholder values with your actual configuration
# 3. For production, use Azure App Configuration + Key Vault
# ===================================================================

# NextAuth Configuration - REQUIRED
# Generate a secure random string (32+ characters) for production
NEXTAUTH_SECRET=your-32-plus-character-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# ===================================================================
# AZURE APP CONFIGURATION - NEW SECURE SETUP
# ===================================================================
# Choose ONE method based on your environment:

# METHOD 1: Development (Local) - Use connection string
AZURE_APP_CONFIG_CONNECTION_STRING=Endpoint=https://your-appconfig.azconfig.io;Id=xxx;Secret=xxx

# METHOD 2: Production - Use endpoint with Managed Identity
AZURE_APP_CONFIG_ENDPOINT=https://your-appconfig.azconfig.io
AZURE_CLIENT_ID=your-managed-identity-client-id
AZURE_TENANT_ID=your-tenant-id

# Configuration version/label (optional)
APP_VERSION=current

# ===================================================================
# FALLBACK CONFIGURATION (if Azure App Config fails)
# ===================================================================
# These will be used as fallback if Azure App Configuration is unavailable

# Azure SQL Database
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=your-database-name
AZURE_SQL_USER=your-admin-username
AZURE_SQL_PASSWORD=your-secure-password

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your-account;AccountKey=your-key;EndpointSuffix=core.windows.net
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account
AZURE_STORAGE_ACCOUNT_KEY=your-storage-key

# AI API - Hyperbolic.xyz
HYPERBOLIC_API_KEY=your-hyperbolic-api-key
HYPERBOLIC_API_URL=https://api.hyperbolic.xyz/v1/chat/completions

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common

# ===================================================================
# AZURE RESOURCES SETUP GUIDE
# ===================================================================
#
# 1. Azure App Configuration:
#    - Create App Configuration store in Azure Portal
#    - Add your secrets to Azure Key Vault
#    - Reference Key Vault secrets in App Configuration
#    - Set up Managed Identity for production access
#
# 2. Key Vault References Format:
#    In App Configuration, store secrets as:
#    {"uri":"https://your-keyvault.vault.azure.net/secrets/secret-name"}
#
# 3. Managed Identity Setup:
#    - Create User Assigned Managed Identity
#    - Grant it access to App Configuration and Key Vault
#    - Use the Client ID in AZURE_CLIENT_ID
#
# 4. Local Development:
#    - Use Azure CLI: az login
#    - Or use connection string for App Configuration
#
# ===================================================================